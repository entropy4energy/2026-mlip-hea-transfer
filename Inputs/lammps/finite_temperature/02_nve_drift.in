# NVE energy-drift production from a separately accepted equilibrated state.

clear
units           metal
dimension       3
boundary        p p p
atom_style      atomic
atom_modify     map yes

variable        MODEL index model.pth
variable        PLUGIN index libdeepmd_lmp.so
variable        DATA index equilibrated.data
variable        ARCH index unknown
variable        MODEL_ID index unknown
variable        PHASE index unknown
variable        CNA_CUTOFF index 4.16452
variable        TEMP index 300.0
variable        DT index 0.001
variable        N_PROD index 50000
variable        THERMO_EVERY index 1000
variable        SAMPLE_EVERY index 100
variable        DUMP_EVERY index 4000
variable        RESTART_EVERY index 25000

plugin          load ${PLUGIN}
read_data       ${DATA}
change_box      all triclinic

mass            1 178.49
mass            2 95.95
mass            3 180.94788
mass            4 47.867
mass            5 91.224

pair_style      deepmd ${MODEL}
pair_coeff      * * Hf Mo Ta Ti Zr
neighbor        2.5 bin
neigh_modify    every 1 delay 0 check yes
newton          on
timestep        ${DT}

thermo          ${THERMO_EVERY}
thermo_style    custom step time atoms temp press pe ke etotal econserve vol density &
                lx ly lz xy xz yz
thermo_modify   lost error norm no flush yes

velocity        all zero linear
reset_timestep  0

variable        sample_time equal step*dt
variable        sample_atoms equal count(all)
variable        sample_temp equal temp
variable        sample_press equal press
variable        sample_pepa equal pe/atoms
variable        sample_kepa equal ke/atoms
variable        sample_etotalpa equal etotal/atoms
fix             ENERGY all ave/time ${SAMPLE_EVERY} 1 ${SAMPLE_EVERY} &
                v_sample_time v_sample_atoms v_sample_temp v_sample_press &
                v_sample_pepa v_sample_kepa v_sample_etotalpa &
                file nve_energy_samples.dat &
                title1 "# NVE energy-drift samples in LAMMPS metal units" &
                title2 "# Step time_ps natoms temperature_K pressure_bar potential_eV_per_atom kinetic_eV_per_atom total_eV_per_atom"

compute         phase_class all cna/atom ${CNA_CUTOFF}
variable        is_unknown atom c_phase_class==5
variable        is_bcc atom c_phase_class==3
variable        is_fcc atom c_phase_class==1
variable        is_hcp atom c_phase_class==2
variable        is_ico atom c_phase_class==4
compute         n_unknown all reduce sum v_is_unknown
compute         n_bcc all reduce sum v_is_bcc
compute         n_fcc all reduce sum v_is_fcc
compute         n_hcp all reduce sum v_is_hcp
compute         n_ico all reduce sum v_is_ico
variable        frac_unknown equal c_n_unknown/v_sample_atoms
variable        frac_bcc equal c_n_bcc/v_sample_atoms
variable        frac_fcc equal c_n_fcc/v_sample_atoms
variable        frac_hcp equal c_n_hcp/v_sample_atoms
variable        frac_ico equal c_n_ico/v_sample_atoms
fix             STRUCTURESAMPLE all ave/time ${SAMPLE_EVERY} 1 ${SAMPLE_EVERY} &
                v_sample_time v_sample_atoms v_frac_unknown v_frac_bcc v_frac_fcc &
                v_frac_hcp v_frac_ico file structure_samples.dat &
                title1 "# Fixed-cutoff CNA fractions during NVE; 1 FCC, 2 HCP, 3 BCC, 4 ICO, 5 unknown" &
                title2 "# Step time_ps natoms fraction_unknown fraction_bcc fraction_fcc fraction_hcp fraction_ico"

fix             NVE all nve
dump            TRAJ all custom ${DUMP_EVERY} trajectory_nve.lammpstrj &
                id type element x y z ix iy iz c_phase_class
dump_modify     TRAJ element Hf Mo Ta Ti Zr sort id
restart         ${RESTART_EVERY} restart.nve.*
run             ${N_PROD}

write_data      nve_final.data nocoeff
write_restart   nve_final.restart
print           "Completed NVE drift run for ${MODEL_ID} ${PHASE} at ${TEMP} K with dt=${DT} ps"
